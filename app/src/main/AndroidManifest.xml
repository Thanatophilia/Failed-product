<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Stage 4.4.2-R1：按键震动直接调用 Vibrator（normal 权限，仅声明即可） -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SilentIME">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            SilentIME 输入法服务注册。
            三要素缺一不可：
              1) android:permission="android.permission.BIND_INPUT_METHOD"  由系统绑定
              2) intent-filter action="android.view.InputMethod"            标识为输入法
              3) meta-data android.view.im -> @xml/method                   输入法元数据
        -->
        <service
            android:name=".SilentImeService"
            android:exported="true"
            android:label="@string/ime_service_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

    </application>

</manifest>